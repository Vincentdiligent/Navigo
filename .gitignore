# --- Never publish the signing identity or machine-local paths ---
# The keystore and its passwords stay on the release machine; CI injects them
# from repository secrets (see .github/workflows/release.yml).
/android/app/key.properties
**/*.keystore
**/*.jks
# Regenerated by `flutter build` with paths that only exist on one laptop.
/android/local.properties

# Built APKs are published through GitHub Releases, not the repository.
*.apk
*.aab
